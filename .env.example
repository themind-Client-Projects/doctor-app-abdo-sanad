# Copy to .env.local and fill in. Only DATABASE_URL and AUTH_SECRET are needed
# to boot: every integration below degrades to a disabled feature rather than a
# crash when its variables are unset.

# ── Database (required) ─────────────────────────────────────────────────────
# Postgres. Prisma 7 reaches it through @prisma/adapter-pg, and the Prisma
# config does NOT auto-load .env — CLI commands run under `dotenvx run -f .env.local`.
DATABASE_URL=postgresql://user:password@localhost:5432/warid

# ── Auth (required) ─────────────────────────────────────────────────────────
# Signs the access tokens. Without it `src/lib/tokens.ts` throws on first sign-in
# rather than issuing anything unsigned. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in for patients. Unset means the Google button is inert — phone
# OTP still works. The client id ends in .apps.googleusercontent.com; a short
# value is a placeholder, not a credential.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The native apps' OWN Google client ids — comma separated, iOS and Android.
#
# A phone's Google SDK mints an ID token whose `aud` is the client id of THAT
# platform, not the web one above, so `grantType: "google"` on
# POST /api/auth/token rejects every real device until these are listed here.
# Leave empty and only web Google sign-in works; the grant then answers 422
# rather than pretending the token was bad.
#
# These are public identifiers, not secrets — a mobile app ships its client id
# inside the binary. There is no matching secret for a native client.
GOOGLE_MOBILE_CLIENT_IDS=

# ── OTP delivery (UltraMsg / WhatsApp) ──────────────────────────────────────
# Unset in development: the code is written to the OTPCode row and logged, so
# phone sign-in is testable without sending a real message.
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# ── Transactional email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── File storage (Supabase) ─────────────────────────────────────────────────
# Holds radiology images and uploaded documents. The NEXT_PUBLIC_ pair is
# exposed to the browser by design; the service role key never is — keep it out
# of any NEXT_PUBLIC_ name.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Wayl payment gateway (https://api.thewayl.com/reference) ────────────────
# Unset in development: `isConfigured()` is false, the top-up button is hidden,
# and the endpoint answers 503 instead of throwing at a patient.
WAYL_API_KEY=
# Sent as the X-WAYL-AUTHENTICATION header — NOT `Authorization`.
WAYL_BASE_URL=https://api.thewayl.com
# Staging: https://api.thewayl-staging.com
WAYL_ENV=test
# "live" or "test". Deliberately separate from NODE_ENV, which is about OUR
# build, not about which of Wayl's ledgers a payment lands in.
WAYL_WEBHOOK_SECRET=
# 10–255 chars. Sent to Wayl on link creation and used to verify the signature
# on the way back, in constant time.
APP_PUBLIC_URL=
# The origin Wayl can reach to deliver a webhook. localhost is never called, so
# a payment made against a local build stays PENDING until reconciled.

# ── Seeding ─────────────────────────────────────────────────────────────────
# `prisma/seed.ts` refuses to run against NODE_ENV=production unless this is
# exactly "true". Leave it unset.
ALLOW_PROD_SEED=
