
# ── Wayl payment gateway (https://api.thewayl.com/reference) ────────────────
# Unset in development: `isConfigured()` is false, the top-up button is hidden,
# and the endpoint answers 503 instead of throwing at a patient.
WAYL_API_KEY=
# Sent as the X-WAYL-AUTHENTICATION header — NOT `Authorization`.
WAYL_BASE_URL=https://api.thewayl.com
# Staging: https://api.thewayl-staging.com
WAYL_ENV=test
# "live" or "test". Deliberately separate from NODE_ENV, which is about OUR
# build, not about which of Wayl's ledgers a payment lands in.
WAYL_WEBHOOK_SECRET=
# 10–255 chars. Sent to Wayl on link creation and used to verify the signature
# on the way back, in constant time.
APP_PUBLIC_URL=
# The origin Wayl can reach to deliver a webhook. localhost is never called, so
# a payment made against a local build stays PENDING until reconciled.
