# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
# Verification builds run with NEXT_DIST_DIR so they cannot clobber a running
# dev server's .next — the output is still a build artifact, never committed.
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
token.md

# Seeded test logins. Real credentials — this repo is pushed to a client
# organisation, so they must never be committed.
SEED_LOGINS.local.md
