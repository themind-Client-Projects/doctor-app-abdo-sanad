// ─────────────────────────────────────────────────────────────
// Warid (وريد) Healthcare Platform — Prisma Schema
// 35 models · 12 enums · All relationships defined
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum UserRole {
  SUPER_ADMIN
  OPERATIONS
  DOCTOR
  LAB
  PHARMACY
  NURSE
  DRIVER
  RADIOLOGY
  PATIENT
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
  PENDING
  PAUSED
}

enum OrderStatus {
  NEW
  ACCEPTED
  ASSIGNED
  IN_TRANSIT
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}

/// ⭐ THE single sales-channel vocabulary.
///
/// Names both where an order came from (`Order.source`) and which storefront a
/// partner sells through (`PartnerChannel.channel`), because they are the same
/// three worlds. A second enum with identical members would drift — the schema
/// already paid that price once with five incompatible `serviceType` sets.
///
///   DIRECT  — وريد المباشر: the main app home and its global services
///   SANAD   — سند: the discount storefront at /sanad, priced from sanadPrice
///   COMPLEX — orders arriving through a medical complex
enum OrderSource {
  COMPLEX
  SANAD
  DIRECT
}

// ⭐ THE single service vocabulary. Order, CommissionRule, ServiceConfig and
// PriceConfig all use this — previously each had its own incompatible strings,
// so pricing/commission lookups matched zero rows.
// Contract.services / Contract.minPrices JSON also key off these member names.
enum ServiceType {
  IN_PERSON_CONSULT // استشارة حضورية / حضوري
  ONLINE_CONSULT // استشارة أونلاين / سند
  HOME_VISIT // زيارة منزلية
  HOME_BLOOD_DRAW // سحب دم منزلي
  HOME_LAB_TEST // تحليل منزلي
  LAB_TEST // تحاليل مختبرية
  RADIOLOGY // أشعة
  PHARMACY_DISPENSE // صرف وصفات
  MEDICINE_DELIVERY // دواء مع توصيل
  NURSING // تمريض
  PHYSIOTHERAPY // علاج طبيعي
  SURGERY // عمليات
  BLOOD_BANK // بنك الدم
  TAXI // نقل
}

enum ServiceStatus {
  ACTIVE
  SUSPENDED
  PAUSED
  REACTIVATED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Priority {
  NORMAL
  URGENT
  CRITICAL
}

// Doctor appointment types (req L195-198)
enum AppointmentType {
  IN_PERSON // حضوري
  ONLINE // أونلاين
  HOME_VISIT // زيارة منزلية
  SURGERY // عمليات
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

// Operations employee availability (req L278)
enum EmployeeAvailability {
  AVAILABLE // متاح
  BUSY // مشغول
  ON_BREAK // استراحة
}

// Notification delivery channel
enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

/// Who receives a slice of an order's revenue.
enum SettlementParty {
  PARTNER // مقدم الخدمة
  COMPLEX // المجمع
  NURSE // الممرض
  DRIVER // السائق
  WARID // المنصة
}

enum SettlementStatus {
  SETTLED
  REVERSED
}

// ═══════════════════════════════════════════════════════════════
// AUTH MODELS (Auth.js / NextAuth)
// ═══════════════════════════════════════════════════════════════

// #1 — Auth.js required: OAuth accounts (Google)
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// #2 — Auth.js required: database sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// #3 — Phone OTP verification via UltraMessages
model OTPCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  verified   Boolean   @default(false)
  /// Failed verification attempts — brute-force guard on a 6-digit code.
  attempts   Int       @default(0)
  /// Set once the code has been redeemed; a consumed code must never re-verify.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([phone, code])
  @@index([phone, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// #3b — Refresh tokens for the mobile client.
///
/// NextAuth's session is a cookie-bound JWT: a native app cannot participate in
/// the browser handshake, and a cookie JWT cannot be revoked. This model backs
/// an opaque, rotating refresh token that CAN be revoked, per device.
model RefreshToken {
  id         String    @id @default(cuid())
  /// SHA-256 of the opaque token. The raw value is never stored, so a database
  /// leak does not hand over live sessions.
  tokenHash  String    @unique
  userId     String
  /// Rotation lineage. Presenting an already-rotated token means the token was
  /// stolen, so the whole family is revoked.
  familyId   String
  expiresAt  DateTime
  /// Set when this token is exchanged. A consumed token must never work again.
  consumedAt DateTime?
  revokedAt  DateTime?
  /// Device context, for a "sign out other devices" screen and for abuse triage.
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════
// CORE MODELS
// ═══════════════════════════════════════════════════════════════

// #4 — All platform users (req L10, L276-277)
model User {
  id            String    @id @default(cuid())
  phone         String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  /// bcrypt hash. Null for patients, who sign in with a phone OTP instead.
  passwordHash  String?
  name          String?
  image         String? // avatar URL
  role          UserRole  @default(PATIENT)
  isActive      Boolean   @default(true)
  governorateId String?
  /// The area within the governorate — for بغداد this is الكرخ or الرصافة.
  ///
  /// Matches `Order.area` and `EmployeeStatus.area`, which are already free
  /// strings drawn from `Governorate.areas`. Required at sign-up only where the
  /// chosen governorate actually defines areas, so it generalises past Baghdad
  /// instead of hardcoding one city's geography.
  area          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  governorate    Governorate?      @relation(fields: [governorateId], references: [id])
  accounts       Account[]
  sessions       Session[]
  refreshTokens  RefreshToken[]
  partner        Partner?
  doctorProfile  DoctorProfile?
  employeeStatus EmployeeStatus?
  notifications  Notification[]
  activityLogs   ActivityLog[]
  patientWallet  PatientWallet?
  callsMade      CallLog[]         @relation("Caller")
  callsReceived  CallLog[]         @relation("Receiver")
  feedbacks      PatientFeedback[]
  addresses      Address[]

  @@index([role, isActive])
  @@index([governorateId])
  @@index([createdAt(sort: Desc)])
}

// #5 — Every service provider (req L129, L142, L151-152)
// isSanadLinked + complexId allow ALL partner types to link to Sanad/Complex
model Partner {
  id            String        @id @default(cuid())
  userId        String        @unique
  type          UserRole // DOCTOR, LAB, PHARMACY, NURSE, DRIVER, RADIOLOGY
  name          String
  phone         String
  email         String?
  governorateId String?
  address       String?
  /// Map position — required by "الموقع على الخريطة" + nearest-provider sort.
  latitude      Float?
  longitude     Float?
  status        PartnerStatus @default(PENDING)
  /// Rating, not money — stays Float on purpose.
  rating        Float         @default(0)
  totalTasks    Int           @default(0)
  complexId     String? // Linked to a medical complex (req L142, L151)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  governorate    Governorate?     @relation(fields: [governorateId], references: [id])
  complex        MedicalComplex?  @relation("PartnerComplex", fields: [complexId], references: [id])
  ownedComplex   MedicalComplex?  @relation("ComplexPartner")
  contract       Contract?
  channels       PartnerChannel[]
  serviceConfigs ServiceConfig[]
  wallet         Wallet?
  debts          Debt[]
  invoices       Invoice[]
  campaigns      Campaign[]

  // Assigned orders
  ordersAsNurse     Order[]   @relation("AssignedNurse")
  ordersAsDriver    Order[]   @relation("AssignedDriver")
  ordersAsLab       Order[]   @relation("AssignedLab")
  ordersAsPharmacy  Order[]   @relation("AssignedPharmacy")
  ordersAsRadiology Order[]   @relation("AssignedRadiology")
  products          Product[]

  @@index([type, status])
  @@index([status])
  @@index([governorateId, type])
  @@index([complexId])
  @@index([createdAt(sort: Desc)])
}

// #6 — Medical complex entity (req L130-139)
model MedicalComplex {
  id        String    @id @default(cuid())
  partnerId String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partner     Partner      @relation("ComplexPartner", fields: [partnerId], references: [id])
  departments Department[]
  partners    Partner[]    @relation("PartnerComplex") // doctors, labs, pharmacies, radiology linked to this complex
}

// #7 — Complex departments (req L135 "إدارة أقسامه")
model Department {
  id        String   @id @default(cuid())
  complexId String
  name      String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  complex MedicalComplex @relation(fields: [complexId], references: [id], onDelete: Cascade)

  @@index([complexId])
}

// #8 — Doctor-specific data (req L140-148)
model DoctorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  /// FK to Specialty. Previously a free String referencing nothing.
  specialtyId String?
  complexId   String? // Linked to complex (req L142 "ربطه بمجمع")
  experience  Int? // years
  gender      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty     Specialty?       @relation(fields: [specialtyId], references: [id])
  schedules     DoctorSchedule[]
  appointments  Appointment[]
  prescriptions Prescription[]
  sanadSessions SanadSession[]

  @@index([createdAt(sort: Desc)])
  @@index([specialtyId])
}

// #9 — Operations employee availability state (req L278)
model EmployeeStatus {
  id               String               @id @default(cuid())
  userId           String               @unique
  availability     EmployeeAvailability @default(AVAILABLE)
  lastSeen         DateTime             @default(now())
  currentTaskCount Int                  @default(0)
  governorateId    String?
  area             String?
  vehicleInfo      String?
  updatedAt        DateTime             @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  governorate Governorate? @relation(fields: [governorateId], references: [id])

  @@index([availability, governorateId])
}

// #10 — Governorate (referenced in L174, L191, L206, L307, L438)
model Governorate {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  areas     Json     @default("[]") // JSON array of areas within the governorate
  updatedAt DateTime @updatedAt

  users             User[]
  partners          Partner[]
  employeeStatuses  EmployeeStatus[]
  orders            Order[]
  bloodBankRequests BloodBankRequest[]
  addresses         Address[]
}

// ═══════════════════════════════════════════════════════════════
// CONTRACT & COMMISSION MODELS
// ═══════════════════════════════════════════════════════════════

// #11 — Per-partner contract (req L199-209, 8 fields)
model Contract {
  id           String   @id @default(cuid())
  partnerId    String   @unique
  startDate    DateTime // تاريخ البداية
  endDate      DateTime // تاريخ الانتهاء
  /// JSON array of ServiceType member names, e.g. ["IN_PERSON_CONSULT"].
  services     Json     @default("[]")
  governorates Json     @default("[]") // المحافظات
  workHours    Json     @default("{}") // ساعات العمل — JSON schedule object
  /// JSON object keyed by ServiceType member name → minimum price.
  minPrices    Json     @default("{}")
  terms        String?  @db.Text // شروط العقد
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner         Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  commissionRules CommissionRule[]

  @@index([isActive, endDate])
}

// #12 — Commission rules ⭐ MOST CRITICAL (req L210-230)
// "أهم جزء في وريد" — per-contract, NEVER hardcoded.
// Shares are Decimal: five of them get multiplied together against real IQD.
model CommissionRule {
  id           String      @id @default(cuid())
  contractId   String
  serviceType  ServiceType
  partnerShare Decimal     @db.Decimal(18, 3) // الشريك %
  complexShare Decimal     @default(0) @db.Decimal(18, 3) // المجمع %
  waridShare   Decimal     @db.Decimal(18, 3) // وريد %
  nurseShare   Decimal     @default(0) @db.Decimal(18, 3) // الممرض % (optional)
  driverShare  Decimal     @default(0) @db.Decimal(18, 3) // السائق % (optional)
  updatedAt    DateTime    @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // NOTE: no separate @@index([contractId]) — the composite unique below is a
  // btree on (contractId, serviceType) and already serves contractId lookups.
  @@unique([contractId, serviceType])
}

// #13 — Service configuration per partner (req L183-198)
// 4 statuses: تفعيل, تعليق, إيقاف مؤقت, إعادة التفعيل
model ServiceConfig {
  id            String        @id @default(cuid())
  partnerId     String
  serviceType   ServiceType
  status        ServiceStatus @default(ACTIVE)
  workHours     Json          @default("{}") // تحديد أوقات العمل
  governorates  Json          @default("[]") // تحديد المحافظات
  dailyCapacity Int? // تحديد الطاقة اليومية
  isHomeService Boolean       @default(false)
  isBloodDraw   Boolean       @default(false) // تفعيل سحب الدم (req L153)
  updatedAt     DateTime      @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, serviceType])
  @@index([partnerId, status])
  @@index([serviceType, status])
}

// ═══════════════════════════════════════════════════════════════
// ORDER & SERVICE MODELS
// ═══════════════════════════════════════════════════════════════

// #14 — Order (req L300-316, 13 fields)
model Order {
  id                   String        @id @default(cuid())
  orderNumber          String        @unique @default(cuid())
  patientId            String // اسم المريض
  patientName          String
  patientPhone         String // رقم الهاتف
  serviceType          ServiceType // نوع الخدمة
  status               OrderStatus   @default(NEW)
  priority             Priority      @default(NORMAL) // درجة الأولوية
  source               OrderSource   @default(DIRECT) // Complex vs Sanad vs Direct
  governorateId        String? // المحافظة
  area                 String? // المنطقة
  address              String? // العنوان
  /// Map position — "الموقع على الخريطة" + nearest-provider dispatch.
  latitude             Float?
  longitude            Float?
  // Money
  subtotal             Decimal?      @db.Decimal(18, 3)
  discountTotal        Decimal?      @db.Decimal(18, 3)
  totalAmount          Decimal?      @db.Decimal(18, 3)
  currency             String        @default("IQD")
  paymentMethod        PaymentMethod @default(CASH) // طريقة الدفع
  paymentStatus        PaymentStatus @default(PENDING) // حالة الدفع
  notes                String?       @db.Text // الملاحظات
  assignedNurseId      String?
  assignedDriverId     String?
  assignedLabId        String?
  assignedPharmacyId   String?
  assignedRadiologyId  String?
  operationsEmployeeId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  governorate         Governorate?         @relation(fields: [governorateId], references: [id])
  assignedNurse       Partner?             @relation("AssignedNurse", fields: [assignedNurseId], references: [id])
  assignedDriver      Partner?             @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  assignedLab         Partner?             @relation("AssignedLab", fields: [assignedLabId], references: [id])
  assignedPharmacy    Partner?             @relation("AssignedPharmacy", fields: [assignedPharmacyId], references: [id])
  assignedRadiology   Partner?             @relation("AssignedRadiology", fields: [assignedRadiologyId], references: [id])
  timeline            OrderTimeline[]
  transactions        Transaction[]
  callLogs            CallLog[]
  labSamples          LabSample[]
  radiologyRequests   RadiologyRequest[]
  prescriptions       Prescription[]       @relation("OrderPrescriptions")
  feedbacks           PatientFeedback[]
  patientTransactions PatientTransaction[]
  orderSettlement     OrderSettlement?

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([priority, status])
  @@index([serviceType])
  @@index([governorateId])
  @@index([patientId])
  @@index([assignedNurseId, status])
  @@index([assignedDriverId, status])
  @@index([assignedLabId, status])
  @@index([assignedPharmacyId, status])
  @@index([assignedRadiologyId, status])
  @@index([operationsEmployeeId, status])
  @@index([paymentStatus])
}

// #15 — 11-step execution timeline (req L384-407)
model OrderTimeline {
  id          String    @id @default(cuid())
  orderId     String
  step        Int // 1-11
  title       String // e.g. "تم إنشاء الطلب", "تم قبول الطلب"
  description String?
  completedAt DateTime?
  completedBy String? // userId who completed this step
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // NOTE: no separate @@index([orderId, step]) — identical to the unique below.
  @@unique([orderId, step])
  @@index([completedBy])
}

// #16 — Doctor appointments (req L22-25, L79-82)
model Appointment {
  id        String          @id @default(cuid())
  doctorId  String
  patientId String
  complexId String?
  type      AppointmentType @default(IN_PERSON)
  date      DateTime
  time      String // e.g. "09:00"
  status    String          @default("scheduled") // scheduled, completed, cancelled, no_show
  price     Decimal?        @db.Decimal(18, 3)
  notes     String?         @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, date])
  @@index([date, status])
  @@index([patientId])
  @@index([complexId])
}

// #17 — Prescriptions (req L35-39, L98)
model Prescription {
  id          String    @id @default(cuid())
  doctorId    String
  patientId   String
  pharmacyId  String?
  orderId     String?
  medications Json      @default("[]") // JSON array of medication objects
  status      String    @default("new") // new, preparing, ready, delivered, returned
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])
  order  Order?        @relation("OrderPrescriptions", fields: [orderId], references: [id])

  @@index([pharmacyId, status])
  @@index([doctorId, createdAt(sort: Desc)])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([orderId])
}

// #18 — Lab sample tracking with 6 statuses (req L455-463)
model LabSample {
  id         String    @id @default(cuid())
  orderId    String?
  labId      String
  nurseId    String?
  sampleType String
  status     String    @default("received")
  // Statuses: received (استلمت), in_lab (وصلت المختبر), testing (قيد الفحص),
  //           ready (النتيجة جاهزة), sent_to_doctor (أرسلت للطبيب), sent_to_patient (أرسلت للمريض)
  results    Json? // Test results JSON
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  order Order? @relation(fields: [orderId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([labId, status])
  @@index([orderId])
  @@index([nurseId])
}

// #19 — Radiology request tracking with 5 statuses (req L465-472)
model RadiologyRequest {
  id              String    @id @default(cuid())
  orderId         String?
  centerId        String
  requestType     String
  equipmentType   String? // نوع الأجهزة (req L166, L371)
  appointmentDate DateTime?
  status          String    @default("scheduled")
  // Statuses: scheduled (الموعد), imaged (تم التصوير), report_ready (التقرير الطبي),
  //           images_attached (الصور المرفقة), sent_to_doctor (إرسال للطبيب)
  report          String?   @db.Text
  images          Json      @default("[]") // Array of Supabase Storage URLs
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  order Order? @relation(fields: [orderId], references: [id])

  @@index([centerId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([appointmentDate])
  @@index([orderId])
}

// #20 — Sanad online consultation sessions (req L445-453)
model SanadSession {
  id              String    @id @default(cuid())
  doctorId        String
  patientId       String
  appointmentTime DateTime
  status          String    @default("waiting")
  // Statuses: waiting (انتظار), calling (جاري الاتصال), in_session, ended (انتهت الجلسة)
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId, appointmentTime])
  @@index([status, appointmentTime])
}

// #21 — Radiology center equipment types (req L166 "أنواع الأجهزة")
model RadiologyEquipment {
  id        String   @id @default(cuid())
  centerId  String // Partner ID of the radiology center
  name      String
  type      String // e.g. "X-Ray", "MRI", "CT", "Ultrasound"
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([centerId, isActive])
}

// ═══════════════════════════════════════════════════════════════
// FINANCIAL MODELS
// ═══════════════════════════════════════════════════════════════

// #22 — Partner wallet (req L241 "رصيد كل شريك")
model Wallet {
  id            String   @id @default(cuid())
  partnerId     String   @unique
  balance       Decimal  @default(0) @db.Decimal(18, 3)
  pendingAmount Decimal  @default(0) @db.Decimal(18, 3) // المستحقات
  totalEarnings Decimal  @default(0) @db.Decimal(18, 3) // إجمالي الأرباح
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partner      Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([balance(sort: Desc)])
}

// #23 — Financial transactions (req L243 "التحويلات")
model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  orderId     String?
  amount      Decimal  @db.Decimal(18, 3)
  type        String // "CREDIT" or "DEBIT"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([walletId, type, createdAt])
  @@index([orderId])
  @@index([createdAt(sort: Desc)])
}

// #24 — Invoices (req L245 "الفواتير")
model Invoice {
  id        String    @id @default(cuid())
  partnerId String
  orderId   String?
  amount    Decimal   @db.Decimal(18, 3)
  status    String    @default("pending") // pending, paid, overdue, cancelled
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([dueDate])
  @@index([orderId])
}

// #25 — Partner debts (req L246 "الديون")
model Debt {
  id        String   @id @default(cuid())
  partnerId String
  amount    Decimal  @db.Decimal(18, 3)
  reason    String?
  dueDate   DateTime
  status    String   @default("pending") // pending, paid, overdue
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([dueDate])
}

// #26 — Price configuration (req L231-238)
model PriceConfig {
  id              String      @id @default(cuid())
  serviceType     ServiceType @unique
  basePrice       Decimal     @db.Decimal(18, 3) // تحديد السعر الأساسي
  sanadPrice      Decimal?    @db.Decimal(18, 3) // تحديد سعر سند
  complexPrice    Decimal?    @db.Decimal(18, 3) // تحديد سعر المجمع
  discountPercent Decimal?    @db.Decimal(18, 3) // تحديد الخصومات
  isActive        Boolean     @default(true)
  updatedAt       DateTime    @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// MARKETING MODELS
// ═══════════════════════════════════════════════════════════════

// #27 — Marketing campaigns (req L237 "الحملات")
model Campaign {
  id             String       @id @default(cuid())
  name           String
  description    String?      @db.Text
  discountType   String // "PERCENTAGE" or "FIXED"
  discountValue  Decimal      @db.Decimal(18, 3)
  startDate      DateTime
  endDate        DateTime
  /// JSON array of ServiceType member names.
  targetServices Json         @default("[]")
  /// Which storefront runs it. NULL means every channel.
  channel        OrderSource?
  /// The clinic or lab running it. NULL is a platform-wide campaign.
  ///
  /// The offer CARD names a provider, shows their rating and their area — none
  /// of which a campaign could supply, so the page invented four clinics that
  /// matched no partner and could not be booked.
  partnerId      String?
  /// Card artwork. Presentation only; the discount is the contract.
  imageUrl       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([isActive, startDate, endDate])
  @@index([partnerId])
}

// #28 — Discount coupons (req L238 "كوبونات الخصم")
model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String // "PERCENTAGE" or "FIXED"
  discountValue Decimal  @db.Decimal(18, 3)
  maxUses       Int      @default(0) // 0 = unlimited
  usedCount     Int      @default(0)
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive, expiresAt])
}

// ═══════════════════════════════════════════════════════════════
// MEDICAL, COMMUNICATION & BLOOD BANK MODELS
// ═══════════════════════════════════════════════════════════════

// #29 — Brief medical file for ops dashboard (req L409-419, 8 fields)
model PatientMedicalRecord {
  id                    String   @id @default(cuid())
  patientId             String   @unique
  medicalHistory        String?  @db.Text // التاريخ المرضي
  chronicDiseases       Json     @default("[]") // الأمراض المزمنة
  allergies             Json     @default("[]") // الحساسية
  currentMedications    Json     @default("[]") // الأدوية الحالية
  latestLabResults      Json? // آخر التحاليل
  latestRadiology       Json? // آخر الأشعة
  previousPrescriptions Json     @default("[]") // الوصفات السابقة
  treatingDoctorId      String? // الطبيب المعالج
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// #30 — Call logs with duration + notes (req L421-431)
model CallLog {
  id           String   @id @default(cuid())
  orderId      String?
  callerId     String
  receiverId   String
  receiverType String // PATIENT, NURSE, LAB, PHARMACY, RADIOLOGY
  duration     Int? // seconds — مدة المكالمات (req L430)
  notes        String?  @db.Text // تسجيل ملاحظات بعد المكالمة (req L431)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order    Order? @relation(fields: [orderId], references: [id])
  caller   User   @relation("Caller", fields: [callerId], references: [id])
  receiver User   @relation("Receiver", fields: [receiverId], references: [id])

  @@index([orderId, createdAt(sort: Desc)])
  @@index([callerId, createdAt(sort: Desc)])
}

// #31 — Blood bank management (req L433-443, 8 fields)
/// #32 — مصرف الدم. The full intake form, per the client's field list.
///
/// The model previously held only bloodType/governorate/status: nine of the
/// twelve fields on the form had nowhere to go, so a request could not identify
/// who made it or what they needed. Everything below is what the app employee
/// receives and acts on.
model BloodBankRequest {
  id String @id @default(cuid())

  /// "REQUESTER" (طالب دم) or "DONOR" (متبرع دم) — the toggle at the top of
  /// the form, which decides whether the operation fields below apply.
  requestType String
  /// Who submitted it, when they are a signed-in user.
  userId      String?

  // ── Identity (الاستمارة) ──────────────────────────────────────────────────
  fullName  String // الاسم الثلاثي
  photoUrl  String? // صورة المستخدم
  age       Int? // العمر
  gender    String? // الجنس
  phone     String // رقم الهاتف
  residence String? // السكن
  /// أقرب نقطة دالة — a landmark, because Iraqi addresses are given by one.
  landmark  String?

  bloodType     BloodType // فصيلة الدم
  governorateId String? // المحافظة
  /// آخر تبرع — drives donor eligibility, which is why it is a date not a note.
  lastDonation  DateTime?

  // ── Only when requestType is REQUESTER ───────────────────────────────────
  operationType  String? // نوع العملية
  bagsNeeded     Int? // عدد أكياس الدم
  operationPlace String? // مكان العملية

  // ── Workflow (موظف التطبيق) ──────────────────────────────────────────────
  /// new → broadcast (أُرسلت للمتبرعين) → matched → fulfilled → cancelled
  status          String    @default("new")
  /// Set when the employee pushes the case to donors inside the app.
  broadcastAt     DateTime?
  donorId         String?
  donorName       String?
  drawAppointment DateTime?
  testStatus      String?
  deliveryStatus  String?
  notes           String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  governorate Governorate? @relation(fields: [governorateId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([bloodType, governorateId])
  @@index([requestType, status])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// FEEDBACK & SYSTEM MODELS
// ═══════════════════════════════════════════════════════════════

// #32 — Patient feedback for satisfaction reports (req L264 "رضا العملاء")
model PatientFeedback {
  id        String   @id @default(cuid())
  patientId String
  orderId   String?
  rating    Int // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User   @relation(fields: [patientId], references: [id])
  order   Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([patientId, createdAt(sort: Desc)])
}

// #33 — Multi-channel notifications (req L12, L283)
model Notification {
  id        String              @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String // order_update, result_ready, appointment_reminder, etc.
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

// #34 — System-wide activity log (req L70 "النشاط الأخير")
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String // e.g. "تم اعتماد تحليل", "تم إرسال وصفة"
  entityType String? // e.g. "order", "lab_sample", "prescription"
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
}

// #35 — Doctor schedule management (req L146 "إدارة الجداول")
model DoctorSchedule {
  id        String   @id @default(cuid())
  doctorId  String
  dayOfWeek Int // 0=Sunday, 6=Saturday
  startTime String // "09:00"
  endTime   String // "17:00"
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  // NOTE: no separate @@index([doctorId, dayOfWeek]) — identical to the unique below.
  @@unique([doctorId, dayOfWeek])
}

/// The commission split actually applied to one completed order.
///
/// Recorded as its own ledger rather than derived on read: CommissionRule is
/// editable, so recomputing later would silently re-split historical orders at
/// today's percentages.
model OrderSettlement {
  id               String           @id @default(cuid())
  orderId          String           @unique
  totalAmount      Decimal          @db.Decimal(18, 3)
  currency         String           @default("IQD")
  /// The rule applied, kept for audit even if the rule is later edited.
  commissionRuleId String?
  status           SettlementStatus @default(SETTLED)
  settledAt        DateTime         @default(now())
  reversedAt       DateTime?
  settledById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  order  Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shares SettlementShare[]

  @@index([status, settledAt(sort: Desc)])
  @@index([settledAt(sort: Desc)])
}

/// One party's slice of a settlement. Sums to exactly the order total.
model SettlementShare {
  id            String          @id @default(cuid())
  settlementId  String
  party         SettlementParty
  /// Null for WARID — the platform is not a Partner and has no wallet row.
  partnerId     String?
  percentage    Decimal         @db.Decimal(9, 4)
  amount        Decimal         @db.Decimal(18, 3)
  /// The wallet credit this produced, when the party has a wallet.
  transactionId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  settlement OrderSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([partnerId, createdAt(sort: Desc)])
  @@index([party])
}

/// One redemption of a coupon.
///
/// Without this, `Coupon.usedCount` was the only record of usage: it was never
/// incremented, maxUses could not be enforced, and a per-user limit was
/// impossible to express. The unique pair also makes double-redemption a
/// database error rather than a race.
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  orderId    String?
  amount     Decimal  @db.Decimal(18, 3)
  redeemedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId, redeemedAt(sort: Desc)])
  @@index([orderId])
}

/// #36 — Medical specialties (التخصصات).
///
/// These lived only in `src/lib/constants/specializations.ts`, so the mobile
/// app had no way to list them and `DoctorProfile.specialtyId` was an
/// unconstrained String pointing at nothing.
model Specialty {
  id        String   @id @default(cuid())
  /// Stable machine key, e.g. "cardiology". Clients branch on this, not on name.
  slug      String   @unique
  name      String
  /// Icon + colour are presentation hints; a native client maps them itself.
  icon      String?
  color     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors DoctorProfile[]

  @@index([isActive, sortOrder])
}

/// #37 — Pharmacy catalogue (المنتجات).
///
/// The product list existed only in the frontend demo file, so the cart could
/// never be validated or priced server-side.
model Product {
  id          String    @id @default(cuid())
  pharmacyId  String
  name        String
  description String?   @db.Text
  category    String?
  price       Decimal   @db.Decimal(18, 3)
  imageUrl    String?
  inStock     Boolean   @default(true)
  requiresRx  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  pharmacy Partner @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, inStock])
  @@index([category])
  @@index([createdAt(sort: Desc)])
}

/// #38 — Saved patient addresses (العناوين).
///
/// Orders carried a free-text address, so a patient retyped it every time and
/// no delivery could be routed to a known location.
model Address {
  id            String    @id @default(cuid())
  userId        String
  label         String?
  governorateId String?
  area          String?
  street        String?   @db.Text
  landmark      String?
  latitude      Float?
  longitude     Float?
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  governorate Governorate? @relation(fields: [governorateId], references: [id])

  @@index([userId, isDefault])
}

// ═══════════════════════════════════════════════════════════════
// STOREFRONT MODELS
//
// What the patient app shows above its operational data: the promo banners at
// the top of the home screen and the subscription packages below them. Both
// lived as inline JSX arrays inside src/app/(patient)/page.tsx, so the client
// could not change a price, run a campaign, or retire a plan without a code
// deploy — and nothing the patient saw was auditable.
//
// Presentation fields (`icon`, `accent`) follow the same contract as
// `Specialty.icon`/`color`: they are hints a client maps to its OWN palette,
// never raw CSS. A native app has no Tailwind classes to apply.
// ═══════════════════════════════════════════════════════════════

/// #39 — Subscription packages (الاشتراكات والباقات).
model HealthPlan {
  id           String  @id @default(cuid())
  name         String
  description  String?
  /// Decimal, not Float — this is IQD the patient is billed.
  monthlyPrice Decimal @db.Decimal(18, 3)
  /// JSON array of feature strings, rendered as the bullet list on the card.
  features     Json    @default("[]")
  /// Palette key the client maps itself, e.g. "blue" | "emerald" | "purple".
  accent       String  @default("blue")
  /// Icon key the client maps itself, e.g. "activity" | "star" | "home".
  icon         String  @default("activity")
  /// Renders the "الأكثر طلباً" ribbon.
  isPopular    Boolean @default(false)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// #40 — Home-screen promo banners (الإعلانات).
model Banner {
  id       String  @id @default(cuid())
  title    String
  subtitle String?
  imageUrl String
  /// Where tapping the banner goes. Null makes it a non-interactive image.
  href     String?

  /// Which storefront shows it. NULL means every channel — the main home and
  /// the Sanad home run different promos, so this is normally set.
  channel   OrderSource?
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  /// Optional flight window. Null on either side means "no bound" — a banner
  /// with no window is always live while `isActive`.
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// #41 — Which storefronts a partner sells through (سند / خارج سند / الاثنان).
///
/// Replaces `Partner.isSanadLinked`, a boolean that was duplicated onto
/// `DoctorProfile.isSanadLinked` with nothing keeping the two in agreement — so
/// a doctor could be inside Sanad according to one row and outside it according
/// to the other, and the patient app had no way to tell which was true.
///
/// A row per channel rather than a column, because a partner is commonly in
/// more than one at different prices, and because membership carries its own
/// state: a lab can be suspended in Sanad while it stays active direct. A
/// boolean can express none of that.
model PartnerChannel {
  id        String      @id @default(cuid())
  partnerId String
  /// DIRECT, SANAD or COMPLEX — see the OrderSource doc comment.
  channel   OrderSource

  /// Status IN THIS CHANNEL, independent of `Partner.status`.
  status   ServiceStatus @default(ACTIVE)
  joinedAt DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, channel])
  @@index([channel, status])
}

/// #42 — The patient's own prepaid balance (محفظتي).
///
/// Deliberately NOT the same table as `Wallet`, which is keyed `partnerId
/// @unique` and is a provider EARNINGS ledger written by `settleOrder`. The two
/// have opposite lifecycles: a partner wallet is credited when an order settles,
/// a patient wallet is debited when one is paid for. Sharing a table would put
/// patient top-ups inside the settlement path and make "sum of transactions ==
/// balance" mean two different things at once.
///
/// The patient header already displays a balance ("150,000 د.ع") and /wallet
/// already lists five transactions — both entirely invented, because nothing
/// behind them existed.
model PatientWallet {
  id      String  @id @default(cuid())
  userId  String  @unique
  balance Decimal @default(0) @db.Decimal(18, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PatientTransaction[]
  payments     PaymentIntent[]
}

/// #43 — Every movement on a patient wallet. The balance is their sum.
model PatientTransaction {
  id       String  @id @default(cuid())
  walletId String
  orderId  String?

  amount Decimal @db.Decimal(18, 3)
  /// "CREDIT" adds to the balance, "DEBIT" removes from it.
  type   String
  /// Why it moved: TOPUP | PAYMENT | REFUND | REWARD.
  reason String  @default("PAYMENT")

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet PatientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order?        @relation(fields: [orderId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@index([orderId])
}

/// #44 — Admin-controlled switches for options the client wants to hold back
/// until they are ready ("يكون معلق تفعيله من الادمن فقط").
///
/// A typed row per switch rather than a generic key/value bag: every one of
/// these gates real money or a real workflow, and `value Json` would mean the
/// difference between `true`, `"true"` and `{enabled:true}` is discovered in
/// production. `numericValue` carries the one parameter some of them need —
/// the taxi nursing add-on has a preset price, not just an on/off.
///
/// Keys are seeded, never created from the UI: a flag the code does not read is
/// a switch that silently does nothing.
model FeatureFlag {
  /// Stable machine key the code branches on, e.g. "booking.electronic".
  key         String  @id
  label       String
  description String?
  /// Groups the admin screen, e.g. "booking" | "taxi" | "sanad".
  group       String  @default("general")

  isEnabled Boolean @default(false)

  /// Optional parameter — money, so Decimal. Null when the flag is a pure toggle.
  numericValue Decimal? @db.Decimal(18, 3)

  updatedAt DateTime @updatedAt

  @@index([group])
}

/// #45 — A payment attempt against an external gateway (Wayl).
///
/// Its own row rather than a field on the wallet, because a payment has a life
/// of its own: it is created before the money exists, the user may abandon it,
/// and the gateway confirms it asynchronously by webhook — possibly more than
/// once, and possibly out of order.
///
/// `settledAt` is the idempotency key that matters. A webhook that fires twice
/// must credit the wallet ONCE, so crediting is guarded on a transition from
/// unsettled to settled rather than on the webhook's own claim about status.
/// Free money is what the naive version produces.
model PaymentIntent {
  id       String @id @default(cuid())
  walletId String

  /// What we send Wayl as `referenceId` — unique on their side too, so a retry
  /// of the same intent cannot open a second payment link.
  reference String @unique

  /// Major IQD units, matching Wayl's `total`. Their minimum is 1,000.
  amount   Decimal @db.Decimal(18, 3)
  currency String  @default("IQD")

  /// PENDING → SETTLED | CANCELLED | FAILED. Ours, not the gateway's — their
  /// vocabulary (Created/Pending/Processing/Complete/Delivered/Cancelled/
  /// Rejected/Returned) is theirs to change.
  status String @default("PENDING")

  provider       String  @default("WAYL")
  /// Wayl's `id` for the link.
  providerRef    String?
  /// Wayl's `url` — where the patient actually pays.
  checkoutUrl    String?
  /// Their last reported status verbatim, for support and reconciliation.
  providerStatus String?

  /// Set exactly once, when the wallet is credited. The guard against a
  /// repeated webhook paying out twice.
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet PatientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([status])
}
